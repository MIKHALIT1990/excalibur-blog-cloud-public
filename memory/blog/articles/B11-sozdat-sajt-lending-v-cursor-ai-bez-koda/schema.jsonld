      "mainEntity": [
        {
          "@type": "Question",
          "name": "Нужно ли уметь программировать для создания лендинга в Cursor AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет, базовых навыков программирования не требуется. Вы ставите задачу на русском языке в окне Composer, а редактор самостоятельно создает разметку и подключает стили."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько стоит запуск сайта по этой инструкции?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Все инструменты в руководстве полностью бесплатны: базовый режим Cursor, стили Tailwind CDN, 50 заявок в месяц в Formspree и публикация на Vercel Drop не требуют оплаты."
          }
        },
        {
          "@type": "Question",
          "name": "Зачем обязательно использовать файл правил landing.mdc?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Без правил нейросеть создает тяжелые проекты на React или Next.js с десятками служебных файлов, требующие работы в терминале."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если заявка из формы не приходит на почту?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проверьте наличие атрибута name у полей ввода, правильность ссылки на форму Formspree в параметре action и метод отправки POST."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли прикрепить собственный домен к созданному сайту?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, сервис Vercel Drop позволяет бесплатно подключить собственный домен: добавьте домен в настройках проекта и укажите DNS-записи у регистратора."
          }
        }
      ]
