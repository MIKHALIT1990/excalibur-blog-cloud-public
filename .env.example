# Cursor Cloud / self-hosted worker
CURSOR_API_KEY=

# Public site
PUBLIC_SITE_URL=https://ai-brother.ru

# Excalibur BLOG publish (ai-brother.ru article queue API)
EXCALIBUR_BLOG_ALLOW_PUBLISH=no
EXCALIBUR_TOPIC_ID=
EXCALIBUR_PROJECT_ROOT=

# ai-brother.ru API Key (for upload-image.php & publish-next.php)
AB_API_KEY=

# SSH article queue access
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASS=
# SSH_PASSWORD is also supported as an alias for Cloud providers that use this name.
SSH_PASSWORD=
# Queue root on the server (defaults to /home/l/litvinie/ai-brother/queue)
AB_QUEUE_ROOT=/home/l/litvinie/ai-brother/queue

# MCP tokens via env interpolation in mcp.json — never commit real values
# MCP_KV_TOKEN=
